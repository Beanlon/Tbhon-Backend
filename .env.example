# Copy to .env:  copy .env.example .env
# Local DB:     docker compose up -d   then   npx prisma migrate deploy

DATABASE_URL="mysql://tbhon_user:tbhon_password@localhost:3306/tbhon_db"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"
PORT=4000
IOT_API_KEY="your-iot-api-key"

# Email verification (Gmail SMTP + 6-digit OTP) — set on the DROPLET .env, then pm2 restart
# Create an App Password: Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.project@gmail.com
SMTP_PASS=your-16-char-google-app-password
EMAIL_FROM="TBhon <your.project@gmail.com>"
EMAIL_VERIFICATION_CODE_TTL_MINUTES=15
# Log codes to console when SMTP is unset (dev only; do not enable on production)
EMAIL_DEV_LOG_CODE=false
# Email verification is optional at signup; it gates export/share features only (see /screenings/export).
