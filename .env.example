# Copy to .env:  copy .env.example .env
# Local DB:     docker compose up -d   then   npx prisma migrate deploy

DATABASE_URL="mysql://tbhon_user:tbhon_password@localhost:3306/tbhon_db"
JWT_SECRET="replace-with-a-long-random-secret"
# Short-lived access JWT (refresh tokens handle long sessions)
JWT_ACCESS_EXPIRES_IN="15m"
REFRESH_TOKEN_TTL_DAYS=30
PORT=4000
IOT_API_KEY="your-iot-api-key"

# Email verification (6-digit OTP) and password reset — set on the DROPLET .env, then pm2 restart --update-env
BREVO_API_KEY=xkeysib-your-brevo-api-key
EMAIL_FROM="TBhon <noreply@yourdomain.com>"
# Optional if EMAIL_FROM is unset:
# BREVO_SENDER_EMAIL=noreply@yourdomain.com

EMAIL_VERIFICATION_CODE_TTL_MINUTES=15
# Alpha fallback: when true, logs OTP code if email provider is unset OR send fails
EMAIL_DEV_LOG_CODE=false
# Email verification is optional at signup; it gates export/share features only (see /screenings/export).
